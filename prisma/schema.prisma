generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A CLASSE DE ACESSO. Grosseira de propósito: ela decide QUE TELAS a pessoa
// alcança (o gate do middleware, que roda sem banco). Quem decide QUE DADOS ela
// vê é a régua fina em `lib/avaliacoes/regua.ts`, que consulta o vínculo.
//
// ⚠️⚠️ Duas réguas, e é assim mesmo: o middleware não tem banco e a régua tem de
// consultar `setor_avaliador`. A classe é a porta; a régua é o conteúdo. Confiar
// só na porta deixaria um gestor puxar a ficha de qualquer um por URL.
enum UserRole {
  ADMIN // Diretoria e administração: a empresa toda.
  GESTOR // Gestor / Sub-encarregado: o painel e a fila do próprio setor.
  COLABORADOR // Só a própria página de desempenho.
  USUARIO // Legado. Ninguém tem; mantido para não quebrar linha antiga.
  SEM_PERMISSAO // Existe na lista, não entra.
}

model Department {
  id                    String   @id @default(cuid())
  name                  String   @unique
  nexusDepartmentId     String?  @unique @map("nexus_department_id")
  active                Boolean  @default(true)
  /// Setor cuja avaliação CABE À DIRETORIA (decisão do dono, 02/09/2026:
  /// Consultoria e Pousada).
  ///
  /// ⚠️⚠️ Existe como MARCA e não como regra no código porque, sem ela, o setor
  /// aparecia como "ninguém avalia" — que é verdade e é mentira ao mesmo tempo:
  /// não há gestor ali, mas há quem responda. Um setor legitimamente sem chefia
  /// ficaria para sempre no alerta vermelho, e um alerta que não se resolve é um
  /// alerta que se aprende a ignorar.
  ///
  /// ⚠️ Ela também conserta um buraco: até 02/09 o painel ROTULAVA "Avaliado pela
  /// Diretoria" quem era avaliador do próprio setor, e nenhum diretor conseguia
  /// de fato avaliar essa pessoa — o rótulo prometia o que a régua não fazia.
  avaliadoPelaDiretoria Boolean  @default(false) @map("avaliado_pela_diretoria")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  users                 User[]

  @@map("departments")
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  passwordHash    String      @map("password_hash")
  role            UserRole    @default(SEM_PERMISSAO)
  jobTitle        String?     @map("job_title")
  birthDate       DateTime?   @map("birth_date")
  gender          String?
  // CPF (só dígitos). Usado p/ colaboradores STAFF sem Nexus e como chave de
  // casamento na futura importação de ponto/disciplina. Nullable.
  cpf             String?
  active          Boolean     @default(true)
  leftAt          DateTime?   @map("left_at")
  avatarUrl       String?     @map("avatar_url")
  phone           String?
  domainAccount   String?     @map("domain_account")
  windowsUser     String?     @map("windows_user")
  nexusUserId     String?     @unique @map("nexus_user_id")
  origin          String      @default("local")
  /// Sumiu do diretório do Nexus — NÃO é o mesmo que "foi desligado".
  ///
  /// ⚠️⚠️ A distinção conserta um defeito real (02/09/2026): a conta
  /// `Axis Certificados` (certificado digital, setor `Sistemas`, que o Nexus já
  /// exclui do diretório) aparecia na fila de avaliação do TI como se fosse
  /// gente. O sync a havia desligado, mas carimbou uma DATA DE SAÍDA inventada —
  /// o instante em que percebeu a ausência —, e a fila leu isso como "estava
  /// ativa durante a competência" e a incluiu.
  ///
  /// Desligamento de verdade vem do Nexus com `status` e `terminationDate`, e
  /// essa pessoa DEVE ser avaliada pelo mês que trabalhou. Sumir do diretório é
  /// outra coisa: é o Nexus dizendo que aquilo não é (ou não é mais) gente da
  /// casa. Sem separar as duas, ou some quem trabalhou o mês, ou entra o que
  /// nunca foi gente.
  ///
  /// ⚠️ Tem a VOLTA: volta a `false` assim que a pessoa reaparece no diretório.
  foraDoDiretorio Boolean     @default(false) @map("fora_do_diretorio")
  departmentId    String?     @map("department_id")
  department      Department? @relation(fields: [departmentId], references: [id])
  entryDate       DateTime?   @map("entry_date")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

// Linhas cruas da planilha de cadastro (admissão/nascimento) + vínculo.
model PersonalStaging {
  id                String   @id @default(cuid())
  nome              String
  norm              String
  birthRaw          String?  @map("birth_raw")
  admRaw            String?  @map("adm_raw")
  sexo              String?
  situacao          String?
  suggestionNexusId String?  @map("suggestion_nexus_id")
  confidence        String   @default("none")
  matchedNexusId    String?  @map("matched_nexus_id")
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("personal_staging")
}

// Escolaridade REAL (vinda da planilha de RH), por funcionário.
model EmployeeEducation {
  nexusUserId String   @id @map("nexus_user_id")
  level       String?
  sexo        String?
  detail      String?
  raw         Json?
  source      String   @default("planilha")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("employee_education")
}

// Cursos/treinamentos e certificações (listas livres, editadas na ficha).
// Independente da escolaridade. Json = [{ nome: string, ano?: string }].
model EmployeeTraining {
  nexusUserId String   @id @map("nexus_user_id")
  cursos      Json     @default("[]")
  certs       Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("employee_training")
}

// Linhas cruas da planilha + estado do vínculo (alimenta a tela de vínculo).
model EducationStaging {
  id                String   @id @default(cuid())
  nome              String
  norm              String
  level             String?
  sexo              String?
  detail            String?
  raw               Json?
  suggestionNexusId String?  @map("suggestion_nexus_id")
  confidence        String   @default("none")
  matchedNexusId    String?  @map("matched_nexus_id")
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("education_staging")
}

model ClassroomStat {
  nexusUserId      String   @id @map("nexus_user_id")
  videosCompleted  Int      @default(0) @map("videos_completed")
  coursesCompleted Int      @default(0) @map("courses_completed")
  coursesCreated   Int      @default(0) @map("courses_created")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("classroom_stats")
}

// Espelho diário do ClassRoom (por usuário × dia). videos/courses/created no dia.
// Mesmo modelo de radio_daily/whatsapp_daily (sync incremental idempotente).
model ClassroomDaily {
  nexusUserId String   @map("nexus_user_id")
  day         String   @db.VarChar(10) // YYYY-MM-DD
  videos      Int      @default(0)
  courses     Int      @default(0)
  created     Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("classroom_daily")
}

model RadioStat {
  nexusUserId    String    @id @map("nexus_user_id")
  totalSeconds   Int       @default(0) @map("total_seconds")
  sessions       Int       @default(0)
  lastListenedAt DateTime? @map("last_listened_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("radio_stats")
}

// Espelho diário do uso da rádio (por usuário × dia) — base dos filtros de
// período. day = data local (America/Sao_Paulo) vinda do .68. Upsert SET por dia
// torna o sync incremental idempotente.
model RadioDaily {
  nexusUserId String   @map("nexus_user_id")
  day         String   @db.VarChar(10) // YYYY-MM-DD
  seconds     Int      @default(0)
  sessions    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("radio_daily")
}

// Espelho diário do WhatsApp/OneCode (por departamento × dia). abertos = chamados
// criados no dia. color = cor da fila/depto (denormalizada). Mesmo modelo da rádio.
model WhatsappDaily {
  dept        String
  day         String   @db.VarChar(10) // YYYY-MM-DD
  abertos     Int      @default(0)
  finalizados Int      @default(0)
  handleSum   Int      @default(0) @map("handle_sum") // soma de handle_seconds dos finalizados no dia
  color       String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([dept, day])
  @@index([day])
  @@map("whatsapp_daily")
}

// Espelho diário da atividade do CIDE (por usuário × dia): atividades = nº de
// alterações registradas no histórico do CIDE atribuídas à pessoa (responsável),
// excluindo eventos automáticos ("Sistema"). day = data local (America/Sao_Paulo)
// pelo created_at (quando registrada). Sync incremental idempotente (SET).
model CideDaily {
  nexusUserId String   @map("nexus_user_id")
  day         String   @db.VarChar(10) // YYYY-MM-DD
  atividades  Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("cide_daily")
}

// Espelho diário da atividade do HelpDesk (por usuário × dia):
//   opened  = chamados abertos pela pessoa (solicitante, por created_at)
//   resolved = chamados resolvidos pela pessoa (responsável, DONE, por closed_at)
//   resolvedSeconds = soma do tempo de resolução dos resolvidos (p/ tempo médio)
// day = data local (America/Sao_Paulo). Sync incremental idempotente (SET).
model HelpdeskDaily {
  nexusUserId     String   @map("nexus_user_id")
  day             String   @db.VarChar(10) // YYYY-MM-DD
  opened          Int      @default(0)
  resolved        Int      @default(0) // resolvidos no fluxo normal (responsável)
  formalized      Int      @default(0) // serviços formalizados (crédito de quem formalizou)
  // Soma do tempo de resolução do dia (segundos), só dos resolvidos NORMAIS.
  // Int basta: o valor por (pessoa,dia) é pequeno; a acumulação no read usa SUM no banco.
  resolvedSeconds Int      @default(0) @map("resolved_seconds")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("helpdesk_daily")
}

// Espelho diário da atividade do Consultoria Plus (por usuário × dia). Quatro
// contagens por createdAt: estudos publicados, chamados abertos, mensagens em
// chamados, comentários em estudos. day = data local (America/Sao_Paulo) vinda
// do .68. Mesmo modelo da rádio/classroom (sync incremental idempotente, SET).
model ConsultoriaDaily {
  nexusUserId String   @map("nexus_user_id")
  day         String   @db.VarChar(10) // YYYY-MM-DD
  studies     Int      @default(0)
  tickets     Int      @default(0)
  messages    Int      @default(0)
  comments    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("consultoria_daily")
}

// Atendimentos abertos por (departamento, atendente, dia) — ranking de atendentes
// no período, geral e por departamento (do ticket/fila).
model WhatsappAttendantDaily {
  dept        String
  name        String
  day         String   @db.VarChar(10)
  abertos     Int      @default(0)
  finalizados Int      @default(0)
  handleSum   Int      @default(0) @map("handle_sum")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([dept, name, day])
  @@index([day])
  @@index([name])
  @@map("whatsapp_attendant_daily")
}

// Snapshot "agora" do WhatsApp (não é por período): backlog/abertos atuais.
model WhatsappSnapshot {
  id         Int      @id @default(1)
  pendingNow Int      @default(0) @map("pending_now")
  openNow    Int      @default(0) @map("open_now")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_snapshot")
}

// Espelho diário de ASSIDUIDADE (ponto) por pessoa × dia. Importado do dump do
// sistema de ponto "Nexo" (axis_db) — NÃO é pull S2S (não há sistema vivo), é
// import idempotente de arquivo (run-ponto-import.mjs). A chave é personKey =
// nexus_user_id (quando a pessoa tem conta no Nexus) OU user.id local (STAFF/
// Limpeza sem Nexus), mesma convenção da Formação. O dump só traz ATRASOS — não
// há falta nem presença na origem; por isso aqui não há coluna de faltas (faltas
// ficam "sem fonte" na ficha, não zero fabricado).
//   atrasos       = nº de atrasos NÃO abonados no dia (punem a assiduidade)
//   atrasosAbon   = nº de atrasos abonados (justificados — NÃO punem, só exibidos)
//   minutosAtraso = soma dos minutos de atraso (só dos não abonados)
// day = data local (AAAA-MM-DD). Upsert SET por (pessoa,dia) → re-import não duplica.
model AssiduidadeDaily {
  personKey     String   @map("person_key")
  day           String   @db.VarChar(10) // YYYY-MM-DD
  atrasos       Int      @default(0)
  atrasosAbon   Int      @default(0) @map("atrasos_abonados")
  minutosAtraso Int      @default(0) @map("minutos_atraso")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([personKey, day])
  @@index([day])
  @@map("assiduidade_daily")
}

// Eventos de DISCIPLINA (advertências). 1 linha por evento, com motivo. O dump do
// Nexo não traz suspensão (e o dono optou por NÃO derivar de regra) — então só há
// tipo 'advertencia' por ora; o campo tipo/dias deixa o modelo pronto p/ suspensão
// futura. Idempotente por (source, sourceId) = id do evento na origem → re-import
// não duplica. personKey idem AssiduidadeDaily.
model DisciplinaEvento {
  id        String   @id @default(cuid())
  personKey String   @map("person_key")
  source    String   @default("nexo")
  sourceId  String   @map("source_id")
  data      String   @db.VarChar(10) // YYYY-MM-DD
  tipo      String // 'advertencia' | 'suspensao'
  motivo    String?
  dias      Int? // duração (suspensão); null p/ advertência
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([source, sourceId])
  @@index([personKey])
  @@map("disciplina_evento")
}

// Linhas do roster do Nexo (uma por usuário do ponto) + estado do vínculo à pessoa
// do TalentCare. Auditoria do casamento por nome (com depto como desempatador) e
// base de uma futura tela de revisão (como /escolaridade). Recriada a cada import.
model PontoStaging {
  id                  String   @id @default(cuid())
  nexoUserId          String   @map("nexo_user_id")
  nome                String
  norm                String
  depto               String?
  email               String?
  atrasos             Int      @default(0)
  advertencias        Int      @default(0)
  suggestionPersonKey String?  @map("suggestion_person_key")
  confidence          String   @default("none")
  matchedPersonKey    String?  @map("matched_person_key")
  status              String   @default("pending")
  // Ocorrências cruas desta pessoa do Nexo (p/ aplicar o vínculo manual sem o dump):
  // { atrasos: [{day, minutos, abonado}], adverts: [{sourceId, day, motivo}] }.
  occ                 Json?
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("ponto_staging")
}

// Vínculos MANUAIS nexo_user_id → personKey (resolvidos na tela /ponto). Duráveis:
// o import consulta isto e atribui as ocorrências à pessoa certa em re-cargas.
model PontoMatch {
  nexoUserId String   @id @map("nexo_user_id")
  personKey  String   @map("person_key")
  nome       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("ponto_match")
}

// Marcador de última sincronização por fonte (sync incremental).
model SyncWatermark {
  source       String   @id
  lastSyncedAt DateTime @map("last_synced_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sync_watermark")
}

// Espelho diário da GERÊNCIA (mensageria). Duas famílias de métrica na mesma
// linha porque a Gerência tem duas faces: quem SAI (serviços, km, viagens,
// jornada) e quem DEMANDA do escritório (protocolos abertos/aprovados/…).
// A mesma pessoa pode ter as duas — vários cargos fazem saída externa
// eventual, não só os dois motoboys.
model GerenciaDaily {
  nexusUserId    String   @map("nexus_user_id")
  day            String   @db.VarChar(10) // YYYY-MM-DD
  servicos       Int      @default(0)
  km             Int      @default(0)
  saidas         Int      @default(0) // cada saída registrada no app
  viagens        Int      @default(0) // dia com serviço em rota marcada como viagem (fora do estado)
  jornadaMin     Int      @default(0) @map("jornada_min")
  protAbertos    Int      @default(0) @map("prot_abertos")
  protAprovados  Int      @default(0) @map("prot_aprovados")
  servCriados    Int      @default(0) @map("serv_criados")
  reagendados    Int      @default(0)
  cancelados     Int      @default(0)
  datasAlteradas Int      @default(0) @map("datas_alteradas")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("gerencia_daily")
}

// Espelho diário do CHAT INTERNO (por usuário × dia) — 8ª fonte.
//   msgCanais   = mensagens escritas em canal (público ou privado)
//   msgDiretas  = mensagens em conversa direta ou grupo privado
//   msgChamados = mensagens dentro da conversa de um chamado
//   chamadosAbertos/Assumidos/Concluidos = o pedido que ela fez, pegou, entregou
//   segundosResolucao = tempo dos concluídos, em SEGUNDOS DE EXPEDIENTE
//
// ⚠️⚠️ `segundosResolucao` NÃO é relógio de parede. O chat conta só 08h–18h de
// segunda a sexta (`lib/expediente.ts` lá), e a conta vem PRONTA da origem
// justamente para não existir uma segunda verdade sobre quanto um chamado
// levou. Nunca recalcular aqui a partir de datas.
//
// ⚠️ MENSAGEM NÃO ENTRA NO SCORE (decisão do dono, 02/09/2026). Ela aparece na
// ficha, na linha do tempo e na tela do Chat, e fica fora de `activityOf()` e
// de `/api/score-metrics`: o score decide aumento e promoção, e contar mensagem
// premiaria quem mais escreve, não quem mais entrega. Chamado aberto e
// concluído entra — é trabalho pedido e entregue, igual ao HelpDesk.
//
// ⚠️ Há história ANTERIOR ao Chat Interno: o import do Mattermost (24/08/2026)
// gravou a data original da mensagem. Quem veio como autor `legacy` (sem conta
// no Nexus) não tem a quem creditar e fica de fora — por isso a soma daqui é
// menor que o total de mensagens do chat, e isso é o certo.
model ChatDaily {
  nexusUserId        String   @map("nexus_user_id")
  day                String   @db.VarChar(10) // YYYY-MM-DD
  msgCanais          Int      @default(0) @map("msg_canais")
  msgDiretas         Int      @default(0) @map("msg_diretas")
  msgChamados        Int      @default(0) @map("msg_chamados")
  chamadosAbertos    Int      @default(0) @map("chamados_abertos")
  chamadosAssumidos  Int      @default(0) @map("chamados_assumidos")
  chamadosConcluidos Int      @default(0) @map("chamados_concluidos")
  segundosResolucao  Int      @default(0) @map("segundos_resolucao")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@id([nexusUserId, day])
  @@index([day])
  @@map("chat_daily")
}

// Espelho diário dos CHAMADOS do Chat por DEPARTAMENTO × dia.
//
// ⚠️⚠️ São as DUAS FACES do mesmo chamado, e elas NÃO se somam. `pedidos*` é o
// que o setor pediu aos outros; `recebidos*` é o que chegou para ele atender —
// as colunas SOLICITANTE e RESPONSÁVEL da tela de chamados. Somar os dois
// contaria a casa inteira duas vezes.
//
// A chave é o `nexusDepartmentId` (o mesmo id que `departments.nexus_department_id`
// já usa aqui), e não o nome: nome de setor muda e o histórico se perderia.
//
// ⚠️ Chamado cuja função de destino/origem não É um departamento (função
// multi-setor, grupo montado à mão, ou quem pediu não tinha setor) não aparece
// em setor nenhum. A origem devolve essa contagem em `foraDeSetor` e o sync a
// registra no log — espelho que descarta linha em silêncio é o pior dos dois.
model ChatDeptDaily {
  nexusDepartmentId   String   @map("nexus_department_id")
  day                 String   @db.VarChar(10) // YYYY-MM-DD
  pedidosAbertos      Int      @default(0) @map("pedidos_abertos")
  pedidosConcluidos   Int      @default(0) @map("pedidos_concluidos")
  recebidosAbertos    Int      @default(0) @map("recebidos_abertos")
  recebidosConcluidos Int      @default(0) @map("recebidos_concluidos")
  recebidosCancelados Int      @default(0) @map("recebidos_cancelados")
  segundosResolucao   Int      @default(0) @map("segundos_resolucao")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@id([nexusDepartmentId, day])
  @@index([day])
  @@map("chat_dept_daily")
}

/**
 * ============================================================
 * AVALIAÇÃO MENSAL — a nota que uma PESSOA dá a outra.
 * ⚠️⚠️ Não confundir com o `score` (0–100) calculado das 8 fontes integradas.
 * São dois números diferentes, de origens diferentes, e nunca devem virar um só:
 * o score mede atividade registrada, a avaliação mede julgamento humano. O valor
 * está justamente em compará-los — quem produz muito e é mal avaliado (ou o
 * contrário) é o sinal que interessa; a média dos dois não é nada.
 * ============================================================
 */

// Quem pode avaliar em cada setor (decisão do dono, 02/09/2026).
//
// ⚠️⚠️ A régua é do SETOR, não de cada pessoa: Gestor e Sub-encarregado avaliam
// qualquer um do setor e a PRIMEIRA avaliação publicada dá baixa no mês, seja de
// quem for. Por isso não existe "gestor de fulano" — existe "avaliadores do
// setor X", e a fila é uma só.
//
// ⚠️⚠️ A linha é GRAVADA e nunca derivada do cargo na hora. O cargo (`Gestor`,
// `Sub-encarregado`) só serve para SUGERIR o vínculo numa tela onde uma pessoa
// confirma. Poder de avaliar é poder sobre a carreira de alguém: no dia em que
// um setor tiver dois gestores, ou alguém for promovido, a régua derivada
// mudaria sozinha e ninguém saberia. Mesmo princípio dos administradores de
// função do Chat Interno — função com poder não se delega automaticamente.
//
// ⚠️ Setor SEM nenhuma linha aqui = ninguém avalia aquele setor, e a tela diz
// isso em voz alta. Hoje são seis (Limpeza, TI, Cozinha, Consultoria, Entregas,
// Pousada — 13 pessoas), porque nenhum deles tem Gestor cadastrado no Nexus.
// Silêncio aqui viraria 13 pessoas na fila de ninguém, para sempre.
model SetorAvaliador {
  id           String   @id @default(cuid())
  departmentId String   @map("department_id")
  userId       String   @map("user_id")
  /// `gestor` | `sub` — o NÍVEL dentro do setor, e com ele a hierarquia que o
  /// dono fixou em 02/09/2026:
  ///   - quem é `gestor` do setor é avaliado pela DIRETORIA;
  ///   - quem é `sub` é avaliado pelo `gestor` do setor;
  ///   - todo o resto é avaliado pelo `gestor` OU pelo `sub`.
  ///
  /// ⚠️⚠️ O nível mora AQUI e não no cargo do Nexus, pelo mesmo motivo do
  /// vínculo: o cargo sugere, gente confirma. E há casos em que os dois não
  /// coincidem — a Rosemeire tem cargo `Colaborador` e é o topo da Limpeza e da
  /// Cozinha, então o nível dela é `gestor` nos dois.
  ///
  /// ⚠️ `gestor` é o padrão porque quem é escolhido para um setor sem chefia é,
  /// por definição, o topo dele. `sub` é a exceção que se marca.
  nivel        String   @default("gestor") @db.VarChar(10)
  // Quem criou o vínculo (User.id). Null nos criados por "aplicar sugestões".
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("setor_avaliador")
}

// A avaliação de UMA pessoa numa competência (mês). Linha ÚNICA por
// (competência, avaliado): a baixa do mês é uma só, não importa qual avaliador
// do setor a fez.
//
// ⚠️ `departmentId` fica CONGELADO no momento da publicação. A avaliação é do
// setor em que a pessoa estava naquele mês; quem muda de área em novembro não
// pode reescrever o histórico de agosto.
//
// ⚠️⚠️ Publicada NÃO se edita. Correção incrementa `versao`, exige motivo e
// guarda a versão anterior em `AvaliacaoVersao` — as duas ficam visíveis para o
// avaliado. Uma nota que pode ser reescrita depois de a pessoa ler e comentar
// não é registro, é negociação.
model Avaliacao {
  id           String    @id @default(cuid())
  // AAAA-MM. É o mês AVALIADO, não o mês em que se avaliou.
  competencia  String    @db.VarChar(7)
  avaliadoId   String    @map("avaliado_id")
  // Quem salvou/publicou por último. Muda se o outro avaliador do setor corrigir.
  avaliadorId  String    @map("avaliador_id")
  departmentId String?   @map("department_id")
  // rascunho | publicada. Rascunho é invisível para o avaliado.
  status       String    @default("rascunho")
  publishedAt  DateTime? @map("published_at")
  versao       Int       @default(1)
  // Texto livre do avaliador (o "recado do mês"). Opcional.
  comentario   String?
  // Média das notas APLICÁVEIS (critério "não se aplica" fica fora e o peso se
  // redistribui sozinho — é a divisão pelo número de notas que existem).
  // Calculada na publicação e gravada: mudar a lista de critérios amanhã não
  // pode reescrever a média de um mês já fechado.
  media        Float?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  notas   AvaliacaoNota[]
  versoes AvaliacaoVersao[]
  ciencia AvaliacaoCiencia?

  @@unique([competencia, avaliadoId])
  @@index([competencia])
  @@index([avaliadorId])
  @@map("avaliacao")
}

// Uma nota por critério. Tabela separada (e não um Json) porque o gráfico de
// evolução POR CRITÉRIO é o produto final disto — em Json ele viraria uma
// consulta ilegível ou uma varredura em memória.
//
// ⚠️⚠️ `nota` NULA quer dizer "NÃO SE APLICA", e não zero. Liderança de quem não
// lidera ninguém, ou inovação num mês em que ninguém inovou nada: um 7 inventado
// para preencher campo é pior que campo vazio, porque entra na média como se
// fosse observação. Critério nulo sai da conta e o peso se redistribui — mesmo
// mecanismo do `Factor.nota = null` do score.
model AvaliacaoNota {
  avaliacaoId   String  @map("avaliacao_id")
  // entrega | prazo | iniciativa | equipe | comunicacao | conduta | melhoria | lideranca
  criterio      String  @db.VarChar(20)
  nota          Int?
  // ⚠️ Obrigatória para nota < 5 ou > 8 (decisão do dono, 02/09/2026). É o freio
  // mais barato contra a inflação de notas — sem ele a escala vira 8 para todo
  // mundo em três meses e o gráfico vira uma reta. E é o que dá conteúdo à
  // conversa de aumento seis meses depois: um 10 sem motivo não prova nada.
  justificativa String?

  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@id([avaliacaoId, criterio])
  @@map("avaliacao_nota")
}

// O que a avaliação dizia ANTES de cada correção. Escrita só na correção.
model AvaliacaoVersao {
  id          String    @id @default(cuid())
  avaliacaoId String    @map("avaliacao_id")
  versao      Int
  avaliadorId String    @map("avaliador_id")
  publishedAt DateTime? @map("published_at")
  // Por que foi corrigida. Obrigatório — correção sem motivo é reescrita.
  motivo      String?
  comentario  String?
  media       Float?
  // Snapshot das notas daquela versão: [{criterio, nota, justificativa}].
  notas       Json
  createdAt   DateTime  @default(now()) @map("created_at")

  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@unique([avaliacaoId, versao])
  @@map("avaliacao_versao")
}

// A ciência do avaliado + o comentário dele.
//
// ⚠️⚠️ O comentário NÃO muda a nota, e é de propósito: ele fica AO LADO dela,
// permanente, e o avaliador é avisado. Deixar a reação alterar a nota
// transformaria a avaliação numa negociação, e a versão final seria a de quem
// insistiu mais.
//
// ⚠️ `versaoCiente` guarda de QUAL versão a pessoa deu ciência. Se vier uma
// correção depois, a página dela avisa que há versão nova — senão a ciência de
// ontem cobriria um texto que ela nunca leu.
model AvaliacaoCiencia {
  avaliacaoId  String    @id @map("avaliacao_id")
  versaoCiente Int       @map("versao_ciente")
  cienteEm     DateTime  @default(now()) @map("ciente_em")
  comentario   String?
  // Quando o avaliador leu o comentário do avaliado (null = ainda não).
  lidoEm       DateTime? @map("lido_em")

  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@map("avaliacao_ciencia")
}
